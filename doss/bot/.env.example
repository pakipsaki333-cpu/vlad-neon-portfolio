# --- Telegram
BOT_TOKEN=123456:AA...            # у @BotFather
OWNER_ID=                         # можно оставить пустым: владельцем станет тот, кто первым нажмёт /start

# --- тарифы
TRIAL_DAYS=3
TRIAL_GB=10
PLAN_DAYS=30
PLAN_GB=200
STARS_PRICE=150                   # 150 Stars ≈ 119 ₽

# --- где живут конфиги
# demo — заглушка без сервера (для проверки UI)
# local — CLI doss на этой же машине
# ssh — CLI doss на VPN-сервере (прод)
PROVIDER=demo
DOSS_BIN=doss
SSH_HOST=
SSH_USER=root
SSH_KEY=/etc/doss/bot_id_ed25519

# --- подписки по HTTP (необязательно)
SUB_BASE=

DB_PATH=doss.sqlite3
