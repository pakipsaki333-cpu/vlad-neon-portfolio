#!/usr/bin/env bash
#
# doss-doctor — самопроверка всей установки. Ничего не меняет.
#   sudo doss-doctor
#
# Проверяет: Xray и его конфиг, порт, API статистики, состояние пользователей,
# панель, бота, таймеры, трафик-таймер, диск. Печатает, что чинить.
#
set -uo pipefail

ETC="${DOSS_ETC:-/etc/doss}"
STATE="$ETC/state.json"
DOSS_BIN="${DOSS_BIN:-/usr/local/bin/doss}"
XRAY_BIN="${XRAY_BIN:-/usr/local/bin/xray}"
XRAY_CONFIG="${XRAY_CONFIG:-/usr/local/etc/xray/config.json}"
PANEL_URL="${PANEL_URL:-http://127.0.0.1:8080/healthz}"

PASS=0; FAIL=0; WARN=0
ok()   { PASS=$((PASS+1)); printf '\033[1;32m  ✓\033[0m %s\n' "$*"; }
bad()  { FAIL=$((FAIL+1)); printf '\033[1;31m  ✗\033[0m %s\n' "$*"; }
warn() { WARN=$((WARN+1)); printf '\033[1;33m  !\033[0m %s\n' "$*"; }

echo "Doss doctor · $(date -u +%FT%TZ)"
echo "──────────────────────────────────────────────────────────────"

# ------------------------------------------------------------- базовое
if [[ -f "$STATE" ]]; then
  ok "состояние найдено: $STATE"
  HOST="$(jq -r '.server.host // "?"' "$STATE" 2>/dev/null)"
  PORT="$(jq -r '.server.port // 443' "$STATE" 2>/dev/null)"
  DEST="$(jq -r '.server.dest_domain // "?"' "$STATE" 2>/dev/null)"
  USERS_TOTAL="$(jq '.users | length' "$STATE" 2>/dev/null || echo 0)"
  USERS_ACTIVE="$(jq '[.users[] | select(.enabled)] | length' "$STATE" 2>/dev/null || echo 0)"
  ok "узел $HOST:$PORT · маска $DEST · пользователей $USERS_ACTIVE из $USERS_TOTAL"
else
  bad "нет $STATE — VPN-узел не установлен (server/install.sh)"
  HOST=""; PORT="443"
fi

# ------------------------------------------------------------- xray
if command -v systemctl >/dev/null; then
  if systemctl is-active --quiet xray 2>/dev/null; then
    ok "служба xray активна"
  else
    bad "служба xray не работает → systemctl status xray / journalctl -u xray -n 50"
  fi
fi

if [[ -x "$XRAY_BIN" ]]; then
  VERSION="$("$XRAY_BIN" version 2>/dev/null | head -1)"
  ok "xray: ${VERSION:-установлен}"
  if [[ -f "$XRAY_CONFIG" ]]; then
    if "$XRAY_BIN" -test -config "$XRAY_CONFIG" >/dev/null 2>&1; then
      ok "конфиг проходит xray -test"
    else
      bad "конфиг невалиден → $XRAY_BIN -test -config $XRAY_CONFIG"
    fi
  else
    bad "нет конфига $XRAY_CONFIG"
  fi
else
  warn "бинарник xray не найден ($XRAY_BIN)"
fi

# ------------------------------------------------------------- порт
if [[ -n "$PORT" ]]; then
  if command -v ss >/dev/null; then
    if ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${PORT}$"; then
      ok "порт $PORT/tcp слушается"
    else
      bad "порт $PORT/tcp не слушается → journalctl -u xray -n 50"
    fi
  else
    warn "нет ss (iproute2) — пропускаю проверку порта"
  fi
fi

# ---------------------------------------------------- api статистики
if [[ -x "$XRAY_BIN" ]]; then
  if "$XRAY_BIN" api statsquery --server=127.0.0.1:10085 >/dev/null 2>&1; then
    ok "API статистики отвечает (учёт трафика работает)"
  else
    warn "API статистики не отвечает → проверь api/stats в конфиге и перезапусти xray"
  fi
fi

# ------------------------------------------------------------- панель
if curl -fsS --max-time 5 "$PANEL_URL" 2>/dev/null | grep -q '"ok":true'; then
  ok "панель отвечает ($PANEL_URL)"
elif command -v systemctl >/dev/null && systemctl is-active --quiet doss-panel 2>/dev/null; then
  warn "панель запущена, но healthz не ответил (порт 8080 занят?)"
else
  warn "панель не запущена (не критично для VPN) → journalctl -u doss-panel -n 30"
  PANEL_URL=""
fi

# ------------------------------------------------------------- бот
BOT_ENV="${BOT_ENV:-/etc/doss/bot.env}"
if [[ -f "$BOT_ENV" ]] && ! grep -q '^BOT_TOKEN=CHANGE_ME' "$BOT_ENV"; then
  if command -v systemctl >/dev/null && systemctl is-active --quiet doss-bot 2>/dev/null; then
    ok "бот работает (doss-bot)"
  else
    bad "токен есть, но бот не запущен → systemctl restart doss-bot; journalctl -u doss-bot -n 40"
  fi
else
  warn "токен бота не задан — выполни: sudo doss-set-token"
fi

# ------------------------------------------------------------- таймеры
for t in doss-traffic.timer doss-tick.timer doss-keepalive.timer; do
  if command -v systemctl >/dev/null && systemctl is-enabled --quiet "$t" 2>/dev/null; then
    ok "таймер $t включён"
  else
    case "$t" in
      doss-keepalive.timer) warn "таймер $t выключен (нужен только на Oracle Always Free)" ;;
      *) bad "таймер $t не включён → systemctl enable --now $t" ;;
    esac
  fi
done

# ------------------------------------------------------------- прочее
DISK="$(df -P / | awk 'NR==2{print $5}' | tr -d '%')"
if [[ -n "$DISK" && "$DISK" -lt 90 ]]; then
  ok "диск занят на ${DISK}%"
else
  warn "диск занят на ${DISK:-?}% — почисти логи: journalctl --vacuum-size=200M"
fi

if [[ -n "$HOST" ]]; then
  case "$HOST" in 10.*|192.168.*|172.1[6-9].*|172.2*|172.3[01].*)
    warn "в состоянии приватный IP ($HOST) — пользователи не смогут подключиться. Поправь server.host: doss export | jq …"
  ;; esac
fi

echo "──────────────────────────────────────────────────────────────"
printf 'итог: \033[1;32m%d ок\033[0m, \033[1;33m%d внимание\033[0m, \033[1;31m%d ошибок\033[0m\n' "$PASS" "$WARN" "$FAIL"
if [[ "$FAIL" -gt 0 ]]; then
  echo "Строки с ✗ — это то, что нужно починить. Логи: journalctl -u <служба> -n 50"
  exit 1
fi
echo "Всё критичное в порядке."
